 }
+
+// reference look: small white words with a thin dark outline, 3 at a time, low on the screen (above the Shorts buttons),
+// the whole phrase swaps with no pop
+function CleanCaptions({ctx, captions, words}) {
+  const {t, W, H} = ctx;
+  const groups = phrases(words, Math.min(3, captions.maxWords));
+  const g = groups.find((grp, i) => {
+    const nextStart = groups[i + 1]?.[0].start ?? Infinity;
+    return t >= grp[0].start && t < Math.min(nextStart, grp[grp.length - 1].end + 0.4);
+  });
+  if (!g) return null;
+  const s = safeZoneOf(W, H);
+  const y = Math.min(captions.y, s ? s.y1 - 0.06 : 0.8);
+  const size = captions.size;
+  const text = g.map((w) => w.text.replace(/[,;:.!?]+$/, '')).join(' ').toLowerCase();
+  return <div style={{position: 'absolute', left: 0, width: W, top: y * H, transform: 'translateY(-50%)', zIndex: 100, textAlign: 'center',
+    fontFamily: '"Rubik", sans-serif', fontWeight: 800, fontSize: size, lineHeight: 1.1, color: '#FFFFFF', padding: '0 90px', boxSizing: 'border-box',
+    WebkitTextStroke: `${Math.round(size * 0.16)}px #1A1A1A`, paintOrder: 'stroke fill', textShadow: '0 3px 6px rgba(0,0,0,0.25)'}}>{text}</div>;
+}
